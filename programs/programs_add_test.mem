00000013  // 0x00000013 : NOP (ADDI x0, x0, 0) - no operation
00100093  // 0x00100093 : ADDI x1, x0, 1     -> x1 = 1
00200113  // 0x00200113 : ADDI x2, x0, 2     -> x2 = 2
002081B3  // 0x002081B3 : ADD  x3, x1, x2    -> x3 = x1 + x2 = 3
00302023  // 0x00302023 : SW   x3, 0(x0)     -> memory[0] = x3 (store 3)
00002203  // 0x00002203 : LW   x4, 0(x0)     -> x4 = memory[0] (load 3)
001202B3  // 0x001202B3 : ADD  x5, x4, x1    -> x5 = x4 + x1 = 4
00000063  // 0x00000063 : BEQ  x0, x0, 0    -> infinite loop / halt (branch to self)